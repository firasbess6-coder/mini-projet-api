{
  "name": "mini-projet-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de gestion de projets et de taches",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "manager": "node scripts/manager.js",
    "test": "node --test test/api.test.js"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.12.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.2"
  }
}
